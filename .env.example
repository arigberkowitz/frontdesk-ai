# ============================================================================
# FrontDesk AI — environment (PRD §13). Copy to .env.local and fill in.
# Never commit real secrets. .env.local is gitignored.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# Any Postgres works (postgres-js driver).
#   Local dev:   postgresql://YOUR_USER@localhost:5432/frontdesk_ai
#   Neon (prod): pooled connection string, e.g. the line below
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth: Clerk (required to log in) ---------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Where Clerk sends users for auth + after auth (already wired in code).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Voice / telephony: Retell (Phase 1) ------------------------------------
RETELL_API_KEY=""

# --- LLM: Anthropic (onboarding scrape structuring, Phase 2) ----------------
ANTHROPIC_API_KEY=""

# --- Billing: Stripe (Phase 4) ----------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Notifications: Resend (email) + Twilio (SMS) (Phase 1/3) ---------------
RESEND_API_KEY=""
RESEND_FROM="FrontDesk AI <notifications@yourdomain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Booking: Cal.com (Phase 1) ---------------------------------------------
CALCOM_API_KEY=""
# Default Cal.com event type to book against (numeric id).
CALCOM_EVENT_TYPE_ID=""

# --- App ---------------------------------------------------------------------
# Public base URL used to build webhook targets (Retell/Stripe call back here).
# Local dev: http://localhost:3300 (or your tunnel URL, e.g. ngrok, for webhooks).
APP_URL="http://localhost:3300"

# Shared secret the Retell agent-tool callbacks verify (baked into tool URLs at
# provision time). Set a strong random value in production.
AGENT_TOOLS_SECRET=""

# Public phone number for the sales demo agent (shown on the /demo page).
DEMO_PHONE_NUMBER=""

# Secret protecting the digest cron endpoint (/api/cron/digest). Set a strong
# random value; configure Vercel Cron with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""
