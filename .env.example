# ============================================================================
# FrontDesk AI — environment (PRD §13). Copy to .env.local and fill in.
# Never commit real secrets. .env.local is gitignored.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# Any Postgres works (postgres-js driver).
#   Local dev:   postgresql://YOUR_USER@localhost:5432/frontdesk_ai
#   Neon (prod): pooled connection string, e.g. the line below
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth: Clerk (required to log in) ---------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Where Clerk sends users for auth + after auth (already wired in code).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# --- Voice / telephony: Retell (Phase 1) ------------------------------------
RETELL_API_KEY=""

# --- LLM: Anthropic (onboarding scrape structuring, Phase 2) ----------------
ANTHROPIC_API_KEY=""

# --- Billing: Stripe (Phase 4) ----------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Notifications: Resend (email) + Twilio (SMS) (Phase 1/3) ---------------
RESEND_API_KEY=""
RESEND_FROM="FrontDesk AI <notifications@yourdomain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Booking: Cal.com (Phase 1) ---------------------------------------------
CALCOM_API_KEY=""
# Default Cal.com event type to book against (numeric id).
CALCOM_EVENT_TYPE_ID=""

# --- Calendar sync (optional; each option is hidden until its keys are set) --
# Encrypts every business's calendar refresh token / API key at rest. REQUIRED
# in production before anyone connects a calendar. Rotating it disconnects all.
CREDENTIALS_SECRET=""
# Google Calendar one-click connect (Google Cloud OAuth client, "Web application").
# Redirect URI: <APP_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Outlook / Microsoft 365 one-click connect (Azure app registration, multi-tenant
# + personal accounts, delegated Calendars.ReadWrite + offline_access).
# Redirect URI: <APP_URL>/api/calendar/microsoft/callback
# (MS_CLIENT_ID / MS_CLIENT_SECRET are accepted as older aliases.)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- App ---------------------------------------------------------------------
# Public base URL used to build webhook targets (Retell/Stripe call back here).
# Local dev: http://localhost:3300 (or your tunnel URL, e.g. ngrok, for webhooks).
APP_URL="http://localhost:3300"

# Shared secret the Retell agent-tool callbacks verify (baked into tool URLs at
# provision time). Set a strong random value in production.
AGENT_TOOLS_SECRET=""

# Public phone number for the sales demo agent (shown on the /demo page).
DEMO_PHONE_NUMBER=""

# Secret protecting the digest cron endpoint (/api/cron/digest). Set a strong
# random value; configure Vercel Cron with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# Missed-call AI phone callbacks (platform-wide second key). Leave unset/off;
# each business must ALSO turn it on in Settings → Follow-ups.
MISSED_CALL_AI_CALLBACKS=
