{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/digest?period=weekly",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/qa-review",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/nightly-improve",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/outbound-recovery",
      "schedule": "0 17 * * *"
    }
  ]
}
